            "command": "/home/roey/workspace/F-Mark/packages/kernel/node_modules/.bin/tsx /home/roey/workspace/F-Mark/packages/kernel/src/index.ts hook auto-stream --fmark-hook-version managed-only-v1",
            "timeout": 300000
          }
        ]
      }
    ]
  }
}
