    "@xyflow/react": "^12.10.2",
    "dagre": "^0.8.5",
    "gifenc": "1.0.3",
    "gifuct-js": "2.1.2",
    "lucide-react": "^0.469.0",
    "mammoth": "^1.12.0",
    "marked": "^14.1.3",
    "monaco-editor": "^0.52.2",
    "papaparse": "^5.5.3",
    "postprocessing": "^6.39.1",
    "pptx-preview": "^1.0.7",
    "react": "^18.3.1",
