{
  "name": "f-mark",
  "version": "0.4.0",
  "description": "Document-based interface for AI agents to collaborate with humans, on an append-only event log",
  "license": "MIT",
  "type": "module",
  "main": "dist/index.js",
  "bin": {
    "f-mark": "bin/f-mark.js"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "dist",
    "bin",
    "assets"
  ],
  "scripts": {
    "build": "rm -rf dist/renderer && tsc",
    "build:bundle": "node scripts/bundle-renderer.mjs && node scripts/bundle-deps.mjs && node scripts/rewrite-shared-imports.mjs",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@fastify/static": "^8.3.0",
    "@fastify/websocket": "^11.2.0",
    "chokidar": "^4.0.3",
    "fastify": "^5.1.0",
    "gray-matter": "^4.0.3"
  },
  "devDependencies": {
    "@f-mark/shared": "workspace:*",
    "@types/node": "^22.9.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vitest": "^2.1.9",
    "ws": "^8.20.1"
  }
}
